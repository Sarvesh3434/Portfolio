# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The ".env" file is gitignored and is never committed.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Local (username/password) login credentials
LOCAL_USERNAME=Sarvesh
LOCAL_PASSWORD=123456789

# GitHub OAuth App credentials
# Create one at: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the "Authorization callback URL" in your GitHub OAuth App
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
